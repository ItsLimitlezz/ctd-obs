/* The CTD look (Night theme of the CineTech Digital design system), as a variant of OBS's Yami theme. */

@OBSThemeMeta {
    name: 'CTD Night';
    id: 'com.cinetechdigital.ctd.Night';
    extends: 'com.obsproject.Yami';
    author: 'CTD';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: #4A5A63;
    --grey2: #3A4650;
    --grey3: #2C3640;
    --grey4: #222B34;
    --grey5: #1A2127;
    --grey6: #0B1821;
    --grey7: #08111A;
    --grey8: #04070C;

    --blue1: #39E7FF;
    --blue2: #2BC4DA;
    --blue3: #0F5E6E;
    --blue4: #0D4A57;
    --blue5: #0D2B33;
    --blue6: #0A1F25;

    --pink1: #FF4DCD;
    --pink2: #FF00B8;
    --pink3: #C4008D;
    --pink4: #9A006F;
    --pink5: #700051;
    --pink6: #4A0036;

    --white1: #F2FBFF;
    --white2: #DCE8EE;
    --white3: #B9C6CE;
    --white4: #A0B2BC;
    --white5: #8BA3AF;

    --border_radius: 2px;
    --border_radius_small: 0px;
    --border_radius_large: 4px;

    /* CTD docks and windows (CTD Relay, CTD Hub, servers, devices): the CTD plugin leaves its own colours out
     * when the active theme styles #ctdRoot, so they follow the theme */
    --ctd_void: var(--grey8);
    --ctd_surface: var(--grey7);
    --ctd_surface_raised: var(--grey6);
    --ctd_line: var(--grey5);
    --ctd_line_strong: var(--grey4);
    --ctd_ink: var(--white1);
    --ctd_ink_body: var(--white3);
    --ctd_ink_muted: var(--white5);
    --ctd_ink_disabled: var(--grey1);
    --ctd_cyan: var(--blue1);
    --ctd_cyan_hover: #7EF0FF;
    --ctd_cyan_pressed: var(--blue2);
    --ctd_cyan_deep: var(--blue5);
    --ctd_magenta: var(--pink2);
    --ctd_on_accent: var(--grey8);
    --ctd_warning: #E5A50A;
}

QWidget {
    font-family: 'Space Mono', Consolas, 'MS Shell Dlg', monospace;
}

/* CTD docks and windows. Colours, borders and shapes only: the CTD plugin sets fonts in code (capitals and letter
 * spacing), and paints the stripe motif and the primary button's offset shadow itself. */
#ctdRoot { background: var(--ctd_void); }
#ctdRoot QLabel { color: var(--ctd_ink_body); background: transparent; }
#ctdRoot QLabel[ctdRole="title"] { color: var(--ctd_ink); }
#ctdRoot QLabel[ctdRole="eyebrow"] { color: var(--ctd_cyan); }
#ctdRoot QLabel[ctdRole="muted"] { color: var(--ctd_ink_muted); }
#ctdRoot QLabel[ctdRole="warning"] { color: var(--ctd_warning); font-weight: bold; }

#ctdRoot QPushButton { background: transparent; color: var(--ctd_ink); border: 1px solid var(--ctd_line_strong);
    border-radius: 0px; padding: 6px 12px; }
#ctdRoot QPushButton:hover { border-color: var(--ctd_cyan); color: var(--ctd_cyan); }
#ctdRoot QPushButton:focus { border: 1px solid var(--ctd_cyan); }
#ctdRoot QPushButton:pressed { background: var(--ctd_cyan_deep); }
#ctdRoot QPushButton:disabled { color: var(--ctd_ink_disabled); border-color: var(--ctd_line); }
#ctdRoot QPushButton[ctdRole="primary"] { background: var(--ctd_cyan); color: var(--ctd_on_accent); border: none; }
#ctdRoot QPushButton[ctdRole="primary"]:hover { background: var(--ctd_cyan_hover); color: var(--ctd_on_accent); }
#ctdRoot QPushButton[ctdRole="primary"]:pressed { background: var(--ctd_cyan_pressed); }
#ctdRoot QPushButton[ctdRole="primary"]:disabled { background: var(--ctd_line); color: var(--ctd_ink_disabled); }
#ctdRoot QPushButton[ctdRole="hot"] { background: transparent; color: var(--ctd_magenta);
    border: 1px solid var(--ctd_magenta); }
#ctdRoot QPushButton[ctdRole="hot"]:hover { background: var(--ctd_magenta); color: var(--ctd_on_accent); }

#ctdRoot QLineEdit, #ctdRoot QComboBox, #ctdRoot QSpinBox { background: var(--ctd_surface_raised);
    color: var(--ctd_ink); border: 1px solid var(--ctd_line_strong); border-radius: 4px; padding: 4px 8px;
    selection-background-color: var(--ctd_cyan); selection-color: var(--ctd_on_accent); }
#ctdRoot QLineEdit:focus, #ctdRoot QComboBox:focus, #ctdRoot QSpinBox:focus { border: 1px solid var(--ctd_cyan); }
#ctdRoot QLineEdit:disabled, #ctdRoot QComboBox:disabled { color: var(--ctd_ink_disabled); }
#ctdRoot QComboBox::drop-down { border: none; width: 20px; }
#ctdRoot QComboBox::down-arrow { image: url(theme:Dark/collapse.svg); width: 10px; height: 6px; }
#ctdRoot QComboBox QAbstractItemView { background: var(--ctd_surface); color: var(--ctd_ink);
    border: 1px solid var(--ctd_line_strong); selection-background-color: var(--ctd_cyan_deep);
    selection-color: var(--ctd_cyan); outline: 0; }

#ctdRoot QCheckBox { color: var(--ctd_ink_body); spacing: 8px; }
#ctdRoot QCheckBox::indicator { width: 12px; height: 12px; border: 1px solid var(--ctd_line_strong);
    background: var(--ctd_surface_raised); }
#ctdRoot QCheckBox::indicator:hover { border-color: var(--ctd_cyan); }
#ctdRoot QCheckBox::indicator:checked { background: var(--ctd_cyan); border-color: var(--ctd_cyan); }

#ctdRoot QTableWidget, #ctdRoot QListWidget, #ctdRoot QTreeWidget, #ctdRoot QTextBrowser {
    background: var(--ctd_surface); color: var(--ctd_ink_body); border: 1px solid var(--ctd_line);
    border-radius: 4px; gridline-color: var(--ctd_line); outline: 0; }
#ctdRoot QTableWidget::item, #ctdRoot QListWidget::item, #ctdRoot QTreeWidget::item { padding: 3px 4px; }
#ctdRoot QTableWidget::item:selected, #ctdRoot QListWidget::item:selected, #ctdRoot QTreeWidget::item:selected {
    background: var(--ctd_cyan_deep); color: var(--ctd_cyan); }
#ctdRoot QHeaderView::section { background: var(--ctd_void); color: var(--ctd_ink_muted); border: none;
    border-bottom: 1px solid var(--ctd_line); padding: 4px 6px; }
#ctdRoot QTableCornerButton::section { background: var(--ctd_void); border: none; }

#ctdRoot QGroupBox { border: 1px solid var(--ctd_line); border-radius: 4px; margin-top: 14px;
    padding: 10px 8px 8px 8px; }
#ctdRoot QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: var(--ctd_cyan); }

#ctdRoot QFrame#ctdDeviceCard { background: var(--ctd_surface); border: 1px solid var(--ctd_line);
    border-radius: 4px; }

#ctdRoot QScrollArea#ctdScroll, #ctdRoot QWidget#ctdScrollViewport, #ctdRoot QWidget#ctdBody {
    background: transparent; border: none; }

#ctdRoot QScrollBar:vertical { background: var(--ctd_void); width: 8px; margin: 0; }
#ctdRoot QScrollBar:horizontal { background: var(--ctd_void); height: 8px; margin: 0; }
#ctdRoot QScrollBar::handle { background: var(--ctd_line_strong); min-height: 24px; min-width: 24px; }
#ctdRoot QScrollBar::handle:hover { background: var(--ctd_cyan); }
#ctdRoot QScrollBar::add-line, #ctdRoot QScrollBar::sub-line { width: 0; height: 0; }
#ctdRoot QScrollBar::add-page, #ctdRoot QScrollBar::sub-page { background: none; }
