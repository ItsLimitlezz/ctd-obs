#!/usr/bin/env zsh
# CTD OBS: Developer ID signing and notarization of the macOS CI build (.github/workflows/ctd-macos.yaml).
# Setup of the secrets this reads: docs/ctd/macos-signing.md.
#
#   ctd-macos-sign keychain           temporary keychain + certificate import; writes identity=<SHA-1> to GITHUB_OUTPUT
#   ctd-macos-sign sign <app>         sign every Mach-O inside out (hardened runtime, secure timestamp), then verify
#   ctd-macos-sign dmg <app> <dmg>    disk image with the app and an Applications link, signed
#   ctd-macos-sign notarize <app|dmg> submit to Apple's notary service, wait, print the log, fail unless Accepted,
#                                     staple, then check Gatekeeper accepts it
#   ctd-macos-sign cleanup            delete the keychain and every key file (safe to run when nothing was set up)
#
# Secrets arrive as environment variables and are only written to files in a 0700 folder under RUNNER_TEMP, which
# cleanup removes. Nothing here prints them (GitHub masks them in the log as well).

builtin emulate -L zsh
setopt ERR_EXIT PIPE_FAIL NO_UNSET EXTENDED_GLOB

typeset -g repo_root=${0:A:h:h:h}
typeset -g work=${RUNNER_TEMP:?RUNNER_TEMP is not set}/ctd-signing
typeset -g keychain=${work}/ctd-signing.keychain-db

error() { print -r -- "::error::${*}"; exit 1 }

need() {
  local var
  for var (${@}) { [[ -n ${(P)var:-} ]] || error "${var} is empty (see docs/ctd/macos-signing.md)" }
}

# Writes a base64 secret to a file only the runner user can read, ignoring line breaks a copy may have added
write_secret() {
  mkdir -p ${work}
  chmod 700 ${work}
  ( umask 077; print -rn -- ${(P)1//[[:space:]]/} | base64 --decode > ${2} ) || error "${1} is not valid base64"
  [[ -s ${2} ]] || error "${1} decoded to an empty file"
}

keychain() {
  need MACOS_CERT_P12_BASE64 MACOS_CERT_PASSWORD MACOS_KEYCHAIN_PASSWORD APPLE_TEAM_ID
  write_secret MACOS_CERT_P12_BASE64 ${work}/cert.p12

  security delete-keychain ${keychain} 2>/dev/null || true
  security create-keychain -p "${MACOS_KEYCHAIN_PASSWORD}" ${keychain}
  security set-keychain-settings -lut 21600 ${keychain}
  security unlock-keychain -p "${MACOS_KEYCHAIN_PASSWORD}" ${keychain}
  security import ${work}/cert.p12 -k ${keychain} -f pkcs12 -P "${MACOS_CERT_PASSWORD}" \
    -T /usr/bin/codesign -T /usr/bin/security >/dev/null || error 'Importing MACOS_CERT_P12_BASE64 failed (wrong MACOS_CERT_PASSWORD?)'
  rm -f ${work}/cert.p12

  # Apple's Developer ID intermediate certificate, in case the .p12 holds only CTD's own certificate
  if curl -fsSL --retry 3 -o ${work}/DeveloperIDG2CA.cer https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer; then
    security import ${work}/DeveloperIDG2CA.cer -k ${keychain} >/dev/null 2>&1 || true
  else
    print '::warning::Could not download the Developer ID G2 intermediate certificate'
  fi

  # Lets codesign use the private key without a password prompt
  security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "${MACOS_KEYCHAIN_PASSWORD}" ${keychain} >/dev/null

  # Keychain search list: the temporary keychain first, then the runner's own
  local -a others=(${(f)"$(security list-keychains -d user | sed -e 's/^[[:space:]]*"//' -e 's/"$//')"})
  security list-keychains -d user -s ${keychain} ${others:#${keychain}}

  local line="$(security find-identity -v -p codesigning ${keychain} | grep -F 'Developer ID Application' | grep -F "(${APPLE_TEAM_ID})" | head -n 1 || true)"
  if [[ -z ${line} ]] {
    security find-identity -p codesigning ${keychain} || true
    error 'No valid "Developer ID Application" identity for APPLE_TEAM_ID in MACOS_CERT_P12_BASE64'
  }
  local identity="$(print -r -- ${line} | awk '{print $2}')"
  print -r -- "Signing identity: ${${line#*\"}%\"}"
  print -r -- "identity=${identity}" >> ${GITHUB_OUTPUT:?}
}

# CEF's helper apps keep the entitlements obs-browser builds them with (JIT, unsigned executable memory)
helper_entitlements() {
  local dir=${repo_root}/plugins/obs-browser/cmake/macos
  case ${1:t} {
    ('OBS Helper.app') print -r -- ${dir}/entitlements-helper.plist ;;
    ('OBS Helper (GPU).app') print -r -- ${dir}/entitlements-helper.gpu.plist ;;
    ('OBS Helper (Plugin).app') print -r -- ${dir}/entitlements-helper.plugin.plist ;;
    ('OBS Helper (Renderer).app') print -r -- ${dir}/entitlements-helper.renderer.plist ;;
  }
}

sign() {
  need CODESIGN_IDENTITY APPLE_TEAM_ID
  local app=${1:?usage: sign <app>}
  [[ -d ${app} ]] || error "${app} not found"
  app=${app:A}
  local app_entitlements=${repo_root}/frontend/cmake/macos/entitlements.plist
  [[ -f ${app_entitlements} ]] || error "${app_entitlements} not found"

  local -a cs=(codesign --force --timestamp --options runtime --sign ${CODESIGN_IDENTITY} --keychain ${keychain})
  chmod -R u+w ${app}

  # 1. Every Mach-O file that isn't a symlink: dylibs, .so modules, loose executables (obs-ffmpeg-mux), CEF's
  #    libraries. A bundle's main executable is signed again with its bundle in step 2; that's harmless.
  local f
  local -i loose=0
  print '::group::Sign Mach-O files'
  for f (${app}/Contents/**/*(.ND)) {
    if [[ $(file -b ${f}) == Mach-O* ]] {
      ${cs} ${f}
      (( ++loose ))
    }
  }
  print '::endgroup::'

  # 2. Nested bundles (frameworks, plugins, CEF helper apps), deepest first. ** doesn't follow the frameworks'
  #    Versions/Current symlinks, so each bundle comes up once.
  local -a bundles=(${app}/Contents/**/*.(app|appex|bundle|framework|plugin|systemextension|xpc)(/ND))
  local -a ordered=(${(f)"$(for f (${bundles}) { print -r -- "${#${f//[^\/]/}} ${f}" } | sort -rn | cut -d' ' -f2-)"})
  local entitlements
  print '::group::Sign bundles'
  for f (${ordered}) {
    entitlements="$(helper_entitlements ${f})"
    if [[ -n ${entitlements} ]] {
      ${cs} --entitlements ${entitlements} ${f}
    } else {
      ${cs} ${f}
    }
  }
  print '::endgroup::'

  # 3. The app itself, with OBS's app entitlements (frontend/cmake/macos/entitlements.plist)
  ${cs} --entitlements ${app_entitlements} ${app}
  print "Signed ${loose} Mach-O files, ${#ordered} nested bundles and ${app:t}"

  codesign --verify --deep --strict --verbose=2 ${app}

  local details="$(codesign -dvv ${app} 2>&1)"
  print -rl -- ${(M)${(f)details}:#(Identifier|Authority|TeamIdentifier|Timestamp|Runtime Version|CodeDirectory)*}
  [[ ${details} == *"TeamIdentifier=${APPLE_TEAM_ID}"* ]] || error 'The app is not signed with APPLE_TEAM_ID'
  [[ ${details} == *'flags=0x10000(runtime)'* ]] || error 'The app is not signed with the hardened runtime'

  print '::group::App entitlements'
  codesign -d --entitlements - ${app} 2>/dev/null
  print '::endgroup::'

  # Before notarization Gatekeeper says "rejected (source=Unnotarized Developer ID)"; that is expected here. The
  # check that counts runs after stapling (notarize).
  spctl -a -vvv -t exec ${app} 2>&1 || true
}

dmg() {
  need CODESIGN_IDENTITY
  local app=${1:?usage: dmg <app> <dmg>} dmg=${2:?usage: dmg <app> <dmg>}
  local root=${work}/dmg-root
  rm -rf ${root} ${dmg}
  mkdir -p ${root}
  ditto ${app} ${root}/${app:t}
  ln -s /Applications ${root}/Applications

  # hdiutil on GitHub's Macs sometimes fails with "Resource busy"; a retry usually works
  local -i try
  for try ({1..3}) {
    if hdiutil create -volname "${app:t:r}" -srcfolder ${root} -fs HFS+ -format UDZO -ov ${dmg}; then
      break
    fi
    (( try < 3 )) || error 'hdiutil could not create the disk image'
    sleep 15
  }
  rm -rf ${root}

  codesign --force --timestamp --sign ${CODESIGN_IDENTITY} --keychain ${keychain} ${dmg}
  codesign --verify --verbose=2 ${dmg}
}

notarize() {
  need NOTARY_KEY_ID NOTARY_ISSUER_ID NOTARY_KEY_P8_BASE64
  local target=${1:?usage: notarize <app|dmg>}
  [[ -e ${target} ]] || error "${target} not found"
  write_secret NOTARY_KEY_P8_BASE64 ${work}/AuthKey.p8
  local -a auth=(--key ${work}/AuthKey.p8 --key-id ${NOTARY_KEY_ID} --issuer ${NOTARY_ISSUER_ID})

  # An app goes to Apple as a zip; a disk image as it is
  local upload=${target}
  if [[ -d ${target} ]] {
    upload=${work}/notary-upload.zip
    rm -f ${upload}
    ditto -c -k --keepParent ${target} ${upload}
  }

  print -r -- "Submitting ${target:t} for notarization (this waits for Apple's answer)"
  local result=${work}/notary-result.json
  xcrun notarytool submit ${upload} ${auth} --wait --timeout 1h --output-format json > ${result} || true
  [[ ${upload} == ${target} ]] || rm -f ${upload}

  local id="$(plutil -extract id raw -o - ${result} 2>/dev/null || true)"
  local notary_status="$(plutil -extract status raw -o - ${result} 2>/dev/null || true)"
  print -r -- "Notarization of ${target:t}: ${notary_status:-no answer} (submission ${id:-none})"
  [[ -z ${GITHUB_STEP_SUMMARY:-} ]] || print -r -- "- Notarization of \`${target:t}\`: **${notary_status:-no answer}** (submission \`${id:-none}\`)" >> ${GITHUB_STEP_SUMMARY}

  if [[ -n ${id} ]] {
    print '::group::Notary log'
    xcrun notarytool log ${id} ${auth} ${work}/notary-log.json >/dev/null 2>&1 && cat ${work}/notary-log.json || print 'Notary log not available'
    print '\n::endgroup::'
  } else {
    cat ${result} 2>/dev/null || true
  }
  [[ ${notary_status} == Accepted ]] || error "Notarization of ${target:t} was not accepted (${notary_status:-no answer}); see the notary log above"

  xcrun stapler staple ${target}
  xcrun stapler validate ${target}

  local assessment
  if [[ -d ${target} ]] {
    assessment="$(spctl -a -vvv -t exec ${target} 2>&1 || true)"
  } else {
    assessment="$(spctl -a -vvv -t open --context context:primary-signature ${target} 2>&1 || true)"
  }
  print -r -- ${assessment}
  [[ ${assessment} == *': accepted'* && ${assessment} == *'source=Notarized Developer ID'* ]] \
    || error "Gatekeeper does not accept the notarized ${target:t}"
}

cleanup() {
  if [[ -e ${keychain} ]] {
    security delete-keychain ${keychain} 2>/dev/null || true
  }
  rm -rf ${work}
}

case ${1:-} {
  (keychain|sign|dmg|notarize|cleanup) ${@} ;;
  (*) error "usage: ${0:t} keychain | sign <app> | dmg <app> <dmg> | notarize <app|dmg> | cleanup" ;;
}
